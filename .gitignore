# --- Rust / Anchor build output ---
/target/*
!/target/deploy
/target/deploy/*
# Keep ONLY the program keypair committed so the on-chain program id stays
# stable across machines and CI. NOTE: this key controls program upgrades —
# for a real mainnet deployment, rotate it and manage it as a secret.
!/target/deploy/league_escrow-keypair.json
.anchor/
test-ledger/
**/*.rs.bk

