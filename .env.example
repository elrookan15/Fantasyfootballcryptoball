# ---------------------------------------------------------------------------
# RoundBlock Protocol — environment template. Copy to `.env` (never commit it).
# ---------------------------------------------------------------------------

# --- Anchor / Solana CLI (program build, test & deploy) ---
# Cluster RPC used by the Anchor provider and tests.
#   Localnet:  http://127.0.0.1:8899
#   Devnet:    https://api.devnet.solana.com
ANCHOR_PROVIDER_URL=http://127.0.0.1:8899
# Path to the wallet keypair that pays for deploys / signs test txs.
ANCHOR_WALLET=~/.config/solana/id.json

# --- Frontend (app/, Next.js — must be prefixed NEXT_PUBLIC_) ---
# RPC endpoint the browser client talks to. Defaults to devnet if unset.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Human-readable label shown in the UI (devnet | localnet | mainnet-beta).
NEXT_PUBLIC_SOLANA_NETWORK=devnet
