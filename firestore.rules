rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'name', 'createdAt', 'updatedAt']) 
        && data.keys().size() == 4
        && data.email is string && data.email.size() <= 256
        && data.name is string && data.name.size() <= 128
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidUserUpdate(data) {
      return data.email is string && data.email.size() <= 256
        && data.name is string && data.name.size() <= 128
        && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() 
        && request.auth.uid == userId 
        && isValidId(userId)
        && isValidUser(incoming());
      allow update: if isSignedIn() 
        && request.auth.uid == userId 
        && isValidUserUpdate(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'name', 'updatedAt']);
      
      match /chats/{messageId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() 
          && request.auth.uid == userId 
          && isValidId(messageId)
          && incoming().keys().hasAll(['text', 'role', 'createdAt'])
          && incoming().keys().size() == 3
          && incoming().text is string && incoming().text.size() <= 100000
          && incoming().role is string && incoming().role in ['user', 'model', 'system']
          && incoming().createdAt == request.time;
        // immutable messages 
        allow update, delete: if false;
      }
    }
  }
}
